# Keep false while running rounds only in the backend. Set true after deploying
# ElyRushBetting and confirming the signer below has HYPE for gas.
ONCHAIN_INTERACTION_ENABLED=false

# Kinetiq Elysium testnet
ORACLE_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
ORACLE_CHAIN_ID=99801

# Deploy ElyRushBetting and set its address here.
ORACLE_CONTRACT_ADDRESS=0xYOUR_ELYRUSH_BETTING_ADDRESS
ORACLE_CONTRACT_JSON_PATH=app/oracle/artifacts/ElyRushBetting.json

# Must be the key for the address configured as BOTH contract owner and
# resultOracle. The contract owner is required to create rounds; resultOracle
# is required to submit results. Keep this secret out of source control.
ORACLE_PRIVATE_KEY=0x2dd9848cd947c6152fcbf714a2d4e394f9702f8bf204d7f9e3841ff312313235

# Optional, only needed by the legacy stock-vault indexer.
RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
CHAIN_ID=99801
STOCK_VAULT_ADDRESS=

# Stock buying remains disabled for the HYPE winnings flow.
BUYBACK_ENABLED=false
